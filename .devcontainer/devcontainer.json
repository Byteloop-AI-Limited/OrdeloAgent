{
    "name": "OrdeloAgent",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "postCreateCommand": "uv pip install --system -e .",
    "remoteUser": "root",
    "appPort": [
        80
    ]
}