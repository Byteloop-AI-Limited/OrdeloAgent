# Reference for tgram_starter/.env_local  (copy this file to `.env_local` and fill it in).
#   cp tgram_starter/.env_local.example tgram_starter/.env_local
# `.env_local` is gitignored. Never commit real values. Each key maps to a field in config.Settings.
# Also read (lower priority): tgram_starter/.env. Real environment variables win over both.

# bot_token - from @BotFather (/newbot). Treat like a password; /revoke in BotFather if leaked.
TGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# bot_username - WITHOUT the @ (BotFather shows it). Used to build invite links t.me/<username>?start=<code>.
TGRAM_BOT_USERNAME=my_ordelo_test_bot

# webhook_secret - you invent it (A-Z a-z 0-9 _ -, 1-256 chars). Telegram echoes it in the
# X-Telegram-Bot-Api-Secret-Token header; requests without it get 403.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TGRAM_WEBHOOK_SECRET=change-me

# webhook_base_url - public HTTPS URL reaching this app (Cloudflare Tunnel / ngrok), no trailing slash.
# webhook_url = <base>/telegram/webhook   (webhook mode only; not needed for polling)
TGRAM_WEBHOOK_BASE_URL=https://example.trycloudflare.com

# admin_ids - comma-separated numeric Telegram user ids allowed to use /invite and /invites.
# Find yours by messaging @userinfobot, or send /whoami to your bot. Also the notebook's default CHAT_ID.
TGRAM_ADMIN_IDS=

# admin_api_key - protects POST/GET /invites and POST /send (send as header X-Admin-Key).
TGRAM_ADMIN_API_KEY=change-me-too

# invite_ttl_hours - how long an invite link stays valid.
TGRAM_INVITE_TTL_HOURS=48
