      "name": "sbase_rest_ops.py",
      "filePath": "utils_common/db_utils/sbase_rest_ops.py",
      "summary": "Core synchronous and asynchronous Supabase REST client wrapper providing generic CRUD operations (get, insert, update, delete) and RPC function calls using httpx, with SQL-to-REST query translation helpers.",
      "tags": ["service", "data-access", "utility", "api-handler"],
      "complexity": "complex",
      "languageNotes": "Provides both async (httpx.AsyncClient) and sync (httpx.Client) variants for each operation; async variants must be awaited in async contexts, sync variants must be wrapped in asyncio.to_thread() per project convention."
    },
