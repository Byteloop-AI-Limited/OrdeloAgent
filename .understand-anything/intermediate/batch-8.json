      "name": "_bootstrap.py",
      "filePath": ".claude/skills/database-operations/scripts/_bootstrap.py",
      "summary": "Shared bootstrap module for the Claude Code database-operations skill scripts, providing repo path resolution, Supabase client initialisation, JSON loading, and key-value argument parsing utilities used by all sibling CRUD scripts.",
      "tags": ["utility", "entry-point", "service", "config"],
      "complexity": "moderate"
    },
    {
      "id": "function:.claude/skills/database-operations/scripts/_bootstrap.py:ensure_repo_on_path",
      "type": "function",
      "name": "ensure_repo_on_path",
      "filePath": ".claude/skills/database-operations/scripts/_bootstrap.py",
      "lineRange": [12, 31],
      "summary": "Walks up from the current working directory (and an optional env-var override) to find the OrdeloAgent repo root by detecting a `config/__init__.py` sentinel, then inserts it into `sys.path` so project imports resolve correctly.",
      "tags": ["utility", "config", "entry-point"],
      "complexity": "moderate"
    },
    {
      "id": "function:.claude/skills/database-operations/scripts/_bootstrap.py:get_client_ordelo",
      "type": "function",
      "name": "get_client_ordelo",
      "filePath": ".claude/skills/database-operations/scripts/_bootstrap.py",
      "lineRange": [34, 39],
      "summary": "Initialises and returns the Supabase REST client for the given schema, calling `ensure_repo_on_path` first to guarantee the project config is importable.",
      "tags": ["utility", "service", "factory"],
      "complexity": "simple"
    },
    {
      "id": "function:.claude/skills/database-operations/scripts/_bootstrap.py:load_json",
      "type": "function",
      "name": "load_json",
      "filePath": ".claude/skills/database-operations/scripts/_bootstrap.py",
      "lineRange": [42, 49],
      "summary": "Parses JSON from either an inline string or a file path, raising a clear ValueError when neither is provided or when parsing fails.",
      "tags": ["utility", "serialization", "validation"],
      "complexity": "simple"
    },
    {
      "id": "function:.claude/skills/database-operations/scripts/_bootstrap.py:parse_key_value",
      "type": "function",
      "name": "parse_key_value",
      "filePath": ".claude/skills/database-operations/scripts/_bootstrap.py",
      "lineRange": [59, 69],
      "summary": "Parses a list of `key=value` argument strings into a list of `(key, coerced_value)` tuples, with JSON-aware scalar coercion for integers, booleans, and null.",
      "tags": ["utility", "validation", "serialization"],
      "complexity": "simple"
    },
    {
